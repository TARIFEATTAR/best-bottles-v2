# Best Bottles Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL!

# ============================================
# Supabase Configuration
# Get from: https://app.supabase.com → Project Settings → API
# ============================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# Tavus CVI Configuration (Grace avatar + voice)
# Get from: https://platform.tavus.io → Settings → API Keys
# ============================================
VITE_TAVUS_API_KEY=your-tavus-api-key-here
# Replica ID: The avatar face (Tavus → Replicas)
VITE_TAVUS_REPLICA_ID=your-replica-id-here
# Persona ID: Grace's personality, prompt, TTS config (Tavus → Personas)
VITE_TAVUS_PERSONA_ID=your-persona-id-here

# ============================================
# ElevenLabs Configuration (for voice AI in other components)
# Get from: https://elevenlabs.io → Profile → API Keys
# ============================================
VITE_ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key-here
VITE_ELEVENLABS_AGENT_ID=agent_your-agent-id-here

# ============================================
# Google Gemini API Key (for AI chat & label generator)
# Get from: https://aistudio.google.com/app/apikey
# ============================================
VITE_GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Freepik API Key (for AI image generation)
# Get from: https://www.freepik.com/api
# ============================================
VITE_FREEPIK_API_KEY=your-freepik-api-key-here
